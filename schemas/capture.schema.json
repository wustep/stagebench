{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/capture.schema.json",
  "title": "Canonical screenshot capture metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "phase", "url", "capturedAt", "browser", "deviceScaleFactor", "locale", "timezone", "colorScheme", "reducedMotion", "captures"],
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": "string" },
    "phase": { "type": "integer", "minimum": 1, "maximum": 3 },
    "url": { "type": "string" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "browser": { "type": "string" },
    "deviceScaleFactor": { "const": 1 },
    "locale": { "const": "en-US" },
    "timezone": { "const": "UTC" },
    "colorScheme": { "const": "light" },
    "reducedMotion": { "const": "reduce" },
    "captures": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object" } }
  }
}
