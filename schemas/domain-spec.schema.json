{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/domain-spec.schema.json",
  "title": "Stagebench Nord domain specification",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "string" },
    "domain": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["manual", "pages"],
      "properties": {
        "manual": { "type": "string" },
        "pages": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": true
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
