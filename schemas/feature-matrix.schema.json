{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/feature-matrix.schema.json",
  "title": "Stagebench feature matrix",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "stage", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "minLength": 1 }] },
    "stage": { "type": "integer", "minimum": 1, "maximum": 4 },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "tests"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
