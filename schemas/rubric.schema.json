{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/rubric.schema.json",
  "title": "Stagebench evaluation rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "ratingScale", "aggregateStageWeights", "technicalGate", "stages"],
  "properties": {
    "version": { "type": "string" },
    "title": { "type": "string" },
    "ratingScale": { "type": "object" },
    "aggregateStageWeights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 } },
    "technicalGate": { "type": "object" },
    "stages": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["name", "description", "categories"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "required": ["id", "label", "weight", "criteria"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "weight": { "type": "number" },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "label", "weight", "guidance"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "weight": { "type": "number" },
        "guidance": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
