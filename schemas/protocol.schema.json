{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/protocol.schema.json",
  "title": "Stagebench protocol manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phaseCount", "selectionMode", "selection", "variants", "defaultVariant", "manual", "sharedCompletionGates", "phases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "phaseCount": { "const": 3 },
    "selectionMode": { "const": "cumulative-target" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3"],
      "properties": {
        "1": { "const": [1] },
        "2": { "const": [1, 2] },
        "3": { "const": [1, 2, 3] }
      }
    },
    "variants": { "type": "string", "minLength": 1 },
    "defaultVariant": { "type": "string", "minLength": 1 },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "edition", "osVersion"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 }
      }
    },
    "sharedCompletionGates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "phases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "shortTitle", "directory", "prompt", "specs", "outcome", "included", "excluded", "hardGates"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "title": { "type": "string", "minLength": 1 },
        "shortTitle": { "type": "string", "minLength": 1 },
        "directory": { "type": "string", "pattern": "^stage[1-3]$" },
        "prompt": { "type": "string", "pattern": "^prompts/stage[1-3]\\.md$" },
        "specs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^specs/.+\\.json$" } },
        "outcome": { "type": "string", "minLength": 20 },
        "included": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "excluded": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "hardGates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
      }
    }
  }
}
