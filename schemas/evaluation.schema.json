{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/evaluation.schema.json",
  "title": "Stagebench scored evaluation",
  "type": "object",
  "required": ["rubricVersion", "runId", "stage", "status", "evaluator", "evaluatedAt", "summary", "score", "rawScore", "grade", "categories", "technicalGate", "issues"],
  "properties": {
    "rubricVersion": { "type": "string" },
    "runId": { "type": "string" },
    "blindId": { "type": "string" },
    "stage": { "type": "integer", "minimum": 1, "maximum": 4 },
    "status": { "const": "complete" },
    "evaluator": { "type": "string" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "rawScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "grade": { "enum": ["exceptional", "strong", "competent", "developing", "incomplete"] },
    "categories": { "type": "array" },
    "technicalGate": { "type": "object" },
    "issues": { "type": "array" }
  },
  "additionalProperties": true
}
