{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/telemetry.schema.json",
  "title": "Stagebench run telemetry",
  "type": "object",
  "required": ["status", "totals", "phases"],
  "properties": {
    "status": { "enum": ["collecting", "complete", "partial", "unavailable"] },
    "totals": { "$ref": "#/$defs/measurement" },
    "phases": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measurement" } }
  },
  "additionalProperties": false,
  "$defs": {
    "value": {
      "type": "object",
      "required": ["value", "kind"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "kind": { "enum": ["measured", "estimated", "unavailable"] }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["wallTimeSeconds", "inputTokens", "outputTokens", "reasoningTokens", "costUsd", "toolCalls", "subagents", "implementationAttempts", "verifierRepairs"],
      "properties": {
        "wallTimeSeconds": { "$ref": "#/$defs/value" },
        "inputTokens": { "$ref": "#/$defs/value" },
        "outputTokens": { "$ref": "#/$defs/value" },
        "reasoningTokens": { "$ref": "#/$defs/value" },
        "costUsd": { "$ref": "#/$defs/value" },
        "toolCalls": { "$ref": "#/$defs/value" },
        "subagents": { "$ref": "#/$defs/value" },
        "implementationAttempts": { "$ref": "#/$defs/value" },
        "verifierRepairs": { "$ref": "#/$defs/value" }
      },
      "additionalProperties": false
    }
  }
}
