{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/assessment.schema.json",
  "title": "Stagebench blinded assessment",
  "type": "object",
  "required": ["rubricVersion", "stage", "evaluator", "evaluatedAt", "summary", "categories", "issues"],
  "anyOf": [
    { "required": ["blindId"] },
    { "required": ["runId"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "rubricVersion": { "type": "string" },
    "blindId": { "type": "string", "pattern": "^trial-[a-f0-9]{16}$" },
    "runId": { "type": "string" },
    "stage": { "type": "integer", "minimum": 1, "maximum": 4 },
    "evaluator": { "type": "string" },
    "evaluatedAt": { "type": "string" },
    "summary": { "type": "string" },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
    "issues": { "type": "array" }
  },
  "additionalProperties": true,
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "criteria"],
      "properties": {
        "id": { "type": "string" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } }
      },
      "additionalProperties": true
    },
    "criterion": {
      "type": "object",
      "required": ["id", "rating", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "rating": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
