{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/blind-bundle.schema.json",
  "title": "Blinded evaluator bundle metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blindId", "phase", "artifactDigest", "identityBlinded", "identityLeakFiles", "createdAt"],
  "properties": {
    "version": { "const": 1 },
    "blindId": { "type": "string", "pattern": "^trial-[a-f0-9]{16}$" },
    "phase": { "type": "integer", "minimum": 1, "maximum": 3 },
    "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identityBlinded": { "type": "boolean" },
    "identityLeakFiles": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
