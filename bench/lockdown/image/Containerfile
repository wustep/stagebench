# Stagebench lockdown images. One file, two targets:
#
#   gateway    the egress gateway (bench/lockdown/image/gateway.mjs) — the only
#              container with a route to the internet.
#   candidate  the box a candidate agent, its tools, its MCP servers, its
#              subprocesses, and the seal/score gates all run in.
#
# Build both with `pnpm bench lockdown-setup`. Tags are content-addressed from
# this directory, so an image digest in a run record names an exact toolchain.
ARG NODE_IMAGE=docker.io/library/node:24-bookworm-slim

# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS gateway
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
COPY gateway.mjs /opt/stagebench/gateway.mjs
RUN mkdir -p /var/log/gateway && chown node:node /var/log/gateway
USER node
EXPOSE 3128 4873
ENTRYPOINT ["node", "/opt/stagebench/gateway.mjs"]

# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS candidate
ARG PNPM_VERSION=11.28.7
ARG PLAYWRIGHT_VERSION=1.64.1
ARG CODEX_VERSION=0.169.0
ARG CLAUDE_CODE_VERSION=2.1.326
# Extra harness CLIs, space-separated npm specs (e.g. "opencode-ai@1.19.6").
ARG EXTRA_NPM_GLOBALS=""

# The same userland for every harness: what a candidate can shell out to is
# part of the unit under test, so it is pinned here rather than inherited from
# whichever machine the operator happens to use.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl git ripgrep jq less procps python3 unzip xz-utils file patch \
    ffmpeg sox \
  && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

RUN npm install -g \
    pnpm@${PNPM_VERSION} \
    playwright@${PLAYWRIGHT_VERSION} \
    @openai/codex@${CODEX_VERSION} \
    @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    ${EXTRA_NPM_GLOBALS} \
  && npm cache clean --force

# Chromium plus its system libraries and fonts, for the harness's pinned
# Playwright. A candidate that picks another Playwright version fetches its
# browser through the gateway's Playwright mirror instead.
RUN playwright install --with-deps chromium \
  && chmod -R a+rX /opt/ms-playwright \
  && rm -rf /var/lib/apt/lists/*

# uid 1000, non-root, no sudo. /workspace and the home directory exist with the
# right owner so fresh volumes mounted over them inherit it.
RUN usermod -l candidate -d /home/candidate -m node \
  && groupmod -n candidate node \
  && mkdir -p /workspace/candidate /workspace/inputs /srv/stagebench /gate \
  && chown -R candidate:candidate /workspace /home/candidate /gate

COPY entrypoint.sh /opt/stagebench/entrypoint.sh
RUN chmod 0755 /opt/stagebench/entrypoint.sh

USER candidate
ENV HOME=/home/candidate \
    NPM_CONFIG_PREFIX=/home/candidate/.npm-global \
    PNPM_HOME=/home/candidate/.local/share/pnpm \
    PATH=/home/candidate/.npm-global/bin:/home/candidate/.local/share/pnpm:/home/candidate/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace
ENTRYPOINT ["/opt/stagebench/entrypoint.sh"]
CMD ["bash"]
