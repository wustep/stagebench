{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/run.schema.json",
  "title": "Stagebench run record",
  "description": "runs/<id>/run.json. schemaVersion 4 is the current shape; anything older is treated as a frozen legacy record and only projected into the gallery.",
  "type": "object",
  "required": ["id", "model", "status", "startedAt", "updatedAt", "stages"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "id": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "variant": { "type": "string" },
    "target": { "type": "string" },
    "targetPhase": { "type": "integer", "minimum": 1, "maximum": 4 },
    "status": { "type": "string" },
    "startedAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "notes": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "status"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 4 },
          "status": { "type": "string" },
          "artifactDigest": { "type": ["string", "null"] },
          "evaluation": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
