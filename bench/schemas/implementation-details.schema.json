{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagebench.local/schemas/implementation-details.schema.json",
  "title": "Stagebench implementation details",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "phase", "audio"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "phase": { "type": "integer", "minimum": 1, "maximum": 4 },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy", "sampleSources"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "generatedSources": { "type": "array" },
        "sampleSources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "source", "license"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 },
              "files": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
