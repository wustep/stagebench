{
  "$schema": "https://stagebench.local/schemas/implementation-details.schema.json",
  "version": 1,
  "phase": 3,
  "audio": {
    "strategy": "One Web Audio AudioContext routes bundled Grand, Upright, and Electric recordings plus generated piano voices, four distinct live Organ models, and category-specific Synth oscillators through per-section buses, effects, master gain, limiter, and one destination.",
    "generatedSources": [
      {
        "name": "Generated Clav",
        "source": "candidate/src/audio-graph.ts generatedToneType; short percussive additive tone with a high partial.",
        "license": "Original implementation; no third-party audio asset.",
        "files": [],
        "notes": "Used for the selectable Clav type."
      },
      {
        "name": "Generated Digital Piano",
        "source": "candidate/src/audio-graph.ts generatedToneType; additive piano tone with an additional even harmonic.",
        "license": "Original implementation; no third-party audio asset.",
        "files": [],
        "notes": "Used for the selectable Digital type."
      },
      {
        "name": "Generated Mallet Piano",
        "source": "candidate/src/audio-graph.ts generatedToneType; additive base with a strong inharmonic upper partial and faster decay.",
        "license": "Original implementation; no third-party audio asset.",
        "files": [],
        "notes": "Used for the selectable Misc type."
      },
      {
        "name": "Generated Piano fallback",
        "source": "candidate/src/audio.ts renderPianoWave; deterministic five-partial additive source rendered into Web Audio buffers when an instrument recording fails to load.",
        "license": "Original implementation; no third-party audio asset.",
        "files": [],
        "notes": "Fallback status names the selected instrument whose sample load failed. All keys remain playable when Web Audio is available."
      },
      {
        "name": "Live Organ models",
        "source": "candidate/src/audio-graph.ts makeOrganVoice; additive tonewheel, transistor, Farf register, and pipe rank spectra generated at note-on.",
        "license": "Original implementation; live Web Audio oscillators only; no third-party audio asset.",
        "notes": "Four distinct B3, Vox, Farf, and Pipe 1 engines; no organ recordings are bundled."
      },
      {
        "name": "Live Analog Synth",
        "source": "candidate/src/audio-graph.ts makeSynthVoice; live oscillators, noise, filters, envelopes, LFOs, and unison voices.",
        "license": "Original implementation; live Web Audio oscillators only; no third-party audio asset.",
        "notes": "Pure, Sync, Multi, Super, and FM-H categories use distinct source and modulation paths."
      }
    ],
    "sampleSources": [
      {
        "name": "Salamander Grand Piano V3",
        "source": "https://github.com/sfzinstruments/SalamanderGrandPiano",
        "license": "Creative Commons Attribution 3.0 Unported (CC BY 3.0; https://creativecommons.org/licenses/by/3.0/)"
      },
      {
        "name": "Upright Piano KW Kawai",
        "source": "https://github.com/freepats/upright-piano-KW",
        "license": "Creative Commons Zero 1.0 Universal (CC0 1.0; https://creativecommons.org/publicdomain/zero/1.0/)"
      },
      {
        "name": "jRhodes3d Mark I Rhodes",
        "source": "https://github.com/sfzinstruments/jlearman.jRhodes3d",
        "license": "Creative Commons Attribution-NonCommercial 4.0 International (CC BY-NC 4.0; https://creativecommons.org/licenses/by-nc/4.0/)"
      }
    ],
    "notes": [
      "sampleSources lists instrument sets and source licenses; sampleFiles records the selected file paths, upstream source files, MIDI roots, velocity layers, and sizes. public/samples/library.json is the runtime inventory.",
      "Selected FLAC recordings are converted to mono Ogg Vorbis at 44.1 kHz and trimmed to no more than six seconds. The app fetches local public assets only.",
      "Electric sample redistribution is restricted to noncommercial use by CC BY-NC 4.0 and requires attribution; commercial redistribution requires a separate license.",
      "The graph uses one AudioContext. Every voice is owned by its input note and Piano layer; sustain honors SUSTPED; all active sources and graph nodes are released on cleanup."
    ],
