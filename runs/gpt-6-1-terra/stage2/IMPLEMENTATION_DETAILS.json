{
  "$schema": "https://stagebench.local/schemas/implementation-details.schema.json",
  "version": 1,
  "phase": 2,
  "audio": {
    "strategy": "One lazy Web Audio context with Piano A and B source buses through Mod 1, Mod 2, delay, amp/EQ, compressor, reverb and the shared rotary motor, then separate layer levels, master gain, limiter and one destination. Grand, Upright and Electric are recorded samples; Clav, Digital, Misc and loading/error fallback are live synthesis.",
    "generatedSources": [
      {
        "name": "Clav, Digital, Misc and playable fallback",
        "description": "Live oscillator voices and envelopes; not recorded samples.",
        "license": "Original implementation"
      },
      {
        "name": "Reverb impulse responses",
        "description": "Deterministic synthetic noise and decays, generated into Web Audio buffers.",
        "license": "Original implementation"
      },
      {
        "name": "Effect and resonance simulation",
        "description": "Web Audio filters, delay lines, nonlinear curves, oscillators and gain nodes; no recordings.",
        "license": "Original implementation"
      }
    ],
