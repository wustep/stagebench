{
  "$schema": "https://stagebench.local/schemas/feature-matrix.schema.json",
  "version": 1,
  "stage": 1,
  "features": [
    {
      "id": "visual.key-count",
      "title": "Exact keybed geometry",
      "tests": [
        "src/tests/hardware.test.ts"
      ]
    },
    {
      "id": "visual.section-layout",
      "title": "Six sections at documented widths",
      "tests": [
        "src/tests/hardware.test.ts"
      ]
    },
    {
      "id": "visual.control-inventory",
      "title": "Control IDs and landmarks",
      "tests": [
        "src/tests/hardware.test.ts"
      ]
    },
    {
      "id": "interaction.keys",
      "title": "Keyboard pointer and touch",
      "tests": [
        "src/tests/note-lifecycle.test.ts"
      ]
    },
    {
      "id": "interaction.decorative-controls",
      "title": "All visible controls respond to input",
      "tests": [
        "src/tests/hardware.test.ts"
      ]
    },
    {
      "id": "accessibility.controls",
      "title": "Accessible control names and roles",
      "tests": [
        "src/App.test.tsx"
      ]
    },
    {
      "id": "piano.basic-note-lifecycle",
      "title": "Note on/off, overlapping, release",
      "tests": [
        "src/tests/note-lifecycle.test.ts"
      ]
    },
    {
      "id": "piano.basic-inputs",
      "title": "Pointer, keyboard, MIDI inputs",
      "tests": [
        "src/tests/note-lifecycle.test.ts"
      ]
    },
    {
      "id": "piano.basic-sustain-polyphony",
      "title": "Sustain, polyphony, voice stealing",
      "tests": [
        "src/tests/synth-voice.test.ts",
        "src/tests/note-lifecycle.test.ts"
      ]
    },
    {
      "id": "piano.basic-status-cleanup",
      "title": "Loading state and cleanup",
      "tests": [
        "src/App.test.tsx"
      ]
    },
    {
      "id": "regression.chassis",
      "title": "No overflow at viewport sizes",
      "tests": [
        "src/App.test.tsx"
      ]
    }
  ]
}
