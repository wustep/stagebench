{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v24.18.0/bin:$PATH\"; exec pnpm dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "showcase",
      "runtimeExecutable": "zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v24.18.0/bin:$PATH\"; exec pnpm -C showcase dev --port 5199"
      ],
      "port": 5199,
      "autoPort": true
    }
  ]
}
