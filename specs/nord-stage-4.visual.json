{
  "version": "1.1.0",
  "appliesTo": "the shared Nord Stage 4 control deck, common to every variant",
  "variantsSpec": "specs/nord-stage-4.variants.json",
  "defaultVariant": "stage-4-73",
  "keybedNote": "The keybed (key count, range, action) and overall silhouette are variant-specific. Read the run's selected variant in specs/nord-stage-4.variants.json for the source image, measured bounds, aspect ratio, and key model. The control-deck spec below is identical across all three variants.",
  "verticalAllocation": {
    "controlDeckIncludingTopRail": 0.54,
    "keybedIncludingBottomRail": 0.46,
    "tolerance": 0.025
  },
  "horizontalSections": [
    { "id": "performance", "label": "Performance controls", "fraction": 0.13 },
    { "id": "organ", "label": "Organ", "fraction": 0.21 },
    { "id": "piano", "label": "Piano", "fraction": 0.15 },
    { "id": "program", "label": "Program and morph", "fraction": 0.09 },
    { "id": "synth", "label": "Synth", "fraction": 0.21 },
    { "id": "effects", "label": "Layer effects", "fraction": 0.21 }
  ],
  "sectionLandmarks": {
    "performance": {
      "surface": "exposed red chassis",
      "required": ["master level knob", "pitch stick", "modulation wheel", "Nord Stage 4 branding"],
      "forbidden": ["full dark inset plate", "OLED display"]
    },
    "organ": {
      "surface": "dark inset plate with red perimeter",
      "required": ["nine physical drawbars", "level LED ladders", "organ model switches", "percussion controls", "rotary controls"],
      "forbidden": ["wide OLED display", "generic equal-width control grid"]
    },
    "piano": {
      "surface": "dark inset plate with red perimeter",
      "required": ["layer level controls", "piano type selectors", "model selector", "timbre controls", "piano-detail switches"],
      "forbidden": ["wide OLED display", "drawbar bank"]
    },
    "program": {
      "surface": "red and dark central control area",
      "required": ["primary program OLED", "large program encoder", "navigation buttons", "five live-program buttons", "morph controls"],
      "forbidden": ["multiple primary displays"]
    },
    "synth": {
      "surface": "dark inset plate with red perimeter",
      "required": ["single synth OLED", "layer level controls", "oscillator controls", "filter controls", "envelope controls", "LFO and arpeggiator controls"],
      "forbidden": ["wide display spanning the section", "uniform repeated knob matrix"]
    },
    "effects": {
      "surface": "dark inset plate with red perimeter",
      "required": ["two effect groups", "amp simulator and EQ", "delay", "compressor", "reverb", "layer focus controls"],
      "forbidden": ["OLED display", "single undifferentiated control grid"]
    }
  },
  "referenceColors": {
    "chassisMid": "#79232c",
    "chassisDark": "#721f29",
    "panelBlueGray": "#3c424d",
    "keyBlack": "#0b0b0b",
    "keyWhite": "#dcdcdc"
  },
  "presentation": {
    "desktopViewport": { "width": 1440, "height": 900 },
    "narrowViewport": { "width": 390, "height": 844 },
    "desktopInstrumentWidthFraction": { "minimum": 0.88, "maximum": 0.97 },
    "background": "neutral light product-study surface",
    "instrumentVisibleWithoutVerticalScrollAtDesktop": true,
    "allowMarketingHeroAboveInstrument": false,
    "allowReferenceImageAsRenderedBackground": false
  },
  "comparison": {
    "cropRenderedInstrumentBeforeVisualScoring": true,
    "cropReferenceToSelectedVariantBounds": true,
    "compareAgainstSelectedVariantReferenceImage": true,
    "compareInThisOrder": [
      "section landmarks and forbidden hardware",
      "control placement and density",
      "chassis and key geometry",
      "materials and colors",
      "typography and micro-detail"
    ],
    "inventedPrimaryHardwareIsStructuralFailure": true
  }
}
