{
  "name": "stagebench",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": "^24"
  },
  "type": "module",
  "scripts": {
    "bench": "node bench/cli.mjs",
    "telemetry:from-jsonl": "node scripts/parse-subagent-telemetry.mjs",
    "predev": "node bench/cli.mjs reindex",
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "prebuild": "node bench/cli.mjs reindex && node scripts/prepare-reference-photos.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/firewall": "^1.2.6",
    "@vercel/functions": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
