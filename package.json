{
  "name": "stagebench",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch:reference": "node scripts/fetch-reference.mjs",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:gallery": "node --test tests/gallery.test.mjs tests/package-manager.test.mjs",
    "test:evaluator": "node --test tests/evaluator.test.mjs tests/implementation-details.test.mjs tests/report.test.mjs tests/specs.test.mjs",
    "test:verifier": "node .agents/skills/run-nord-benchmark/scripts/verify-stage.mjs self-test",
    "evaluate:rubric": "node .agents/skills/run-nord-benchmark/scripts/evaluate-run.mjs rubric",
    "evaluate:template": "node .agents/skills/run-nord-benchmark/scripts/evaluate-run.mjs template",
    "evaluate:details": "node .agents/skills/run-nord-benchmark/scripts/evaluate-run.mjs details",
    "evaluate:score": "node .agents/skills/run-nord-benchmark/scripts/evaluate-run.mjs score",
    "evaluate:report": "node .agents/skills/run-nord-benchmark/scripts/evaluate-run.mjs report"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
